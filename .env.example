# GWDG LLM endpoint (OpenAI-compatible)
# Note: GWDG model catalogue drifts without notice — verify current names with GET /v1/models
GWDG_API_BASE=https://chat-ai.academiccloud.de/v1
GWDG_API_KEY=your-gwdg-key-here
GWDG_MODEL=meta-llama-3.1-8b-instruct
GWDG_EMBED_MODEL=multilingual-e5-large-instruct

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Optional secondary job source (JSearch / RapidAPI, 200 req/month free tier)
RAPIDAPI_KEY=

# App
LOG_LEVEL=INFO
ARTIFACTS_DIR=./artifacts
