# GWDG LLM endpoint (OpenAI-compatible)
GWDG_API_BASE=https://chat-ai.academiccloud.de/v1
GWDG_API_KEY=your-gwdg-key-here
GWDG_MODEL=apertus-70b-instruct-2509
GWDG_EMBED_MODEL=multilingual-e5-large-instruct
GWDG_TIMEOUT=120                                # per-request LLM timeout (seconds)

# NVIDIA NIM (optional — leave blank/commented to use GWDG only)
# NIM_API_BASE=https://integrate.api.nvidia.com/v1
# NIM_API_KEY=nvapi-...
# NIM_MODEL=meta/llama-3.1-70b-instruct
# NIM_TIMEOUT=30
# NIM_HEALTH_INTERVAL_S=60

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here        # service role (scripts/tests; bypasses RLS)
SUPABASE_ANON_KEY=your-anon-publishable-key     # API per-user client (RLS-bound)
SUPABASE_JWT_SECRET=                            # only if your project signs HS256; ES256 uses JWKS automatically

# API
CORS_ORIGINS=http://localhost:3000              # comma-separated; in production: https://<web>.up.railway.app

# RapidAPI / JSearch (optional secondary job source). Leave blank to disable.
RAPIDAPI_KEY=

# App
LOG_LEVEL=INFO
ARTIFACTS_DIR=./artifacts                       # generated CV/cover-letter files; ephemeral on Railway
MATCHER_MAX_CONCURRENCY=4                       # concurrent LLM calls in matcher; tune to avoid GWDG 429s

# Production (Railway) — PORT is injected automatically; do not set it here
# PORT=  ← set by Railway at runtime

# --- Frontend ---
# For npm run dev: copy frontend/.env.local.example to frontend/.env.local
# For docker compose: uncomment the two lines below — Compose reads them as build-args for the web image
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# (NEXT_PUBLIC_API_BASE_URL is hardcoded to http://localhost:8000 in docker-compose.yml)
