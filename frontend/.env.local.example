# Local development: copy to .env.local and fill in.
# Production (Railway): set these as build-time env vars on the web service — do NOT commit .env.local.
# NEXT_PUBLIC_* values are baked into the Next.js bundle at build time (browser-exposed).
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your supabase anon/publishable key>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000  # production: https://<api>.up.railway.app
